<%- include('../partials/admin-head') %>
<div class="admin-layout">
<%- include('../partials/admin-sidebar') %>
<main class="admin-main">
  <div class="admin-topbar">
    <div class="admin-topbar-title">文章管理</div>
    <div class="admin-topbar-right">
      <a href="/admin/articles/new" class="btn btn-primary btn-sm">✏️ 写文章</a>
    </div>
  </div>
  <div class="admin-content">
    <div class="filter-bar">
      <form method="GET" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <input type="text" name="q" value="<%= q %>" placeholder="🔍 搜索文章..." style="width:220px">
        <select name="status" style="width:130px">
          <option value="">全部状态</option>
          <option value="published" <%= status==='published'?'selected':'' %>>✅ 已发布</option>
          <option value="draft" <%= status==='draft'?'selected':'' %>>📋 草稿</option>
        </select>
        <button class="btn btn-outline btn-sm">筛选</button>
        <% if (q||status) { %><a href="/admin/articles" class="btn btn-ghost btn-sm">清除</a><% } %>
      </form>
    </div>

    <table class="data-table">
      <thead>
        <tr><th>标题</th><th>分类</th><th>状态</th><th>阅读</th><th>发布时间</th><th>操作</th></tr>
      </thead>
      <tbody>
        <% articles.forEach(a => { %>
          <tr>
            <td style="max-width:280px">
              <a href="/admin/articles/<%= a.id %>/edit" style="color:var(--text);font-weight:500;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden"><%= a.title %></a>
            </td>
            <td><span style="font-size:12.5px;color:var(--text-muted)"><%= a.category_name||'—' %></span></td>
            <td><span class="badge badge-<%= a.status %>"><%= a.status==='published'?'已发布':'草稿' %></span></td>
            <td><span style="font-size:13px;color:var(--text-muted)"><%= a.views %></span></td>
            <td><span style="font-size:12.5px;color:var(--text-muted)"><%= dayjs(a.created_at).format('YYYY-MM-DD') %></span></td>
            <td>
              <div style="display:flex;gap:6px">
                <a href="/admin/articles/<%= a.id %>/edit" class="btn btn-outline btn-sm">编辑</a>
                <a href="/article/<%= a.slug %>" target="_blank" class="btn btn-ghost btn-sm">预览</a>
                <form method="POST" action="/admin/articles/<%= a.id %>/delete" style="display:inline" onsubmit="return confirm('确定删除「<%= a.title %>」？')">
                  <button class="btn btn-danger btn-sm">删除</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (articles.length===0) { %>
          <tr><td colspan="6">
            <div class="empty-state"><div class="empty-state-icon">📭</div><p>暂无文章</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>

    <div class="pagination">
      <% if (page>1) { %>
        <a href="?page=<%= page-1 %>&status=<%= status %>&q=<%= q %>" class="btn btn-outline btn-sm">← 上一页</a>
      <% } else { %>
        <button class="btn btn-outline btn-sm" disabled style="opacity:.4;cursor:default">← 上一页</button>
      <% } %>
      <span class="page-info">第 <strong><%= page %></strong> 页 / 共 <strong><%= totalPages %></strong> 页</span>
      <% if (page<totalPages) { %>
        <a href="?page=<%= page+1 %>&status=<%= status %>&q=<%= q %>" class="btn btn-outline btn-sm">下一页 →</a>
      <% } else { %>
        <button class="btn btn-outline btn-sm" disabled style="opacity:.4;cursor:default">下一页 →</button>
      <% } %>
    </div>
  </div>
</main>
</div>
</body></html>
