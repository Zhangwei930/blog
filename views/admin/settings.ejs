<%- include('../partials/admin-head') %>
<div class="admin-layout">
<%- include('../partials/admin-sidebar') %>
<main class="admin-main">
  <div class="admin-topbar">
    <div class="admin-topbar-title">博客设置</div>
  </div>
  <div class="admin-content">
    <% if(saved){%><div class="alert alert-success">✅ 设置已保存！</div><%}%>
    <% if(error){%><div class="alert alert-error">⚠ <%= error %></div><%}%>
    <div class="settings-two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start">
      <form method="POST" action="/admin/settings" class="settings-form">
        <div class="panel">
          <div class="settings-section-title">基本信息</div>
          <label class="form-label">博客名称</label><input type="text" name="blog_name" value="<%= settings.blog_name||'' %>">
          <label class="form-label">博客描述</label><input type="text" name="blog_description" value="<%= settings.blog_description||'' %>">
          <label class="form-label">作者名称</label><input type="text" name="blog_author" value="<%= settings.blog_author||'' %>">
          <label class="form-label">SEO 关键词（逗号分隔）</label><input type="text" name="blog_keywords" value="<%= settings.blog_keywords||'' %>">
          <div class="settings-section-title" style="margin-top:24px">功能设置</div>
          <label class="form-label">每页文章数</label><input type="number" name="posts_per_page" value="<%= settings.posts_per_page||10 %>" min="1" max="50" style="width:100px">
          <label class="form-label">评论审核</label>
          <select name="comment_moderation">
            <option value="true" <%= settings.comment_moderation==='true'?'selected':'' %>>✅ 开启（推荐）</option>
            <option value="false" <%= settings.comment_moderation==='false'?'selected':'' %>>❌ 关闭</option>
          </select>
          <label class="form-label">ICP 备案号</label><input type="text" name="icp_number" value="<%= settings.icp_number||'' %>" placeholder="沪ICP备XXXXXXXX号">
          <label class="form-label">页脚文字</label><input type="text" name="footer_text" value="<%= settings.footer_text||'' %>">
          <label class="form-label">关于我（Markdown）</label><textarea name="about_content" rows="8"><%= settings.about_content||'' %></textarea>
          <button type="submit" class="btn btn-primary" style="margin-top:20px;width:100%">💾 保存设置</button>
        </div>
      </form>
      <div class="panel">
        <div class="settings-section-title">修改密码</div>
        <form method="POST" action="/admin/settings/password" class="settings-form">
          <label class="form-label">当前密码</label><input type="password" name="old_password" required>
          <label class="form-label">新密码（至少8位）</label><input type="password" name="new_password" required minlength="8">
          <button type="submit" class="btn btn-primary" style="margin-top:20px;width:100%">🔐 修改密码</button>
        </form>
      </div>
    </div>
  </div>
</main>
</div>
</body></html>
