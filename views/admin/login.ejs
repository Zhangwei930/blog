<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>登录 - <%= blogName %> 后台</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
  <div class="login-box">
    <div class="login-logo">
      <img src="/images/avatar.svg" alt="logo" class="login-logo-img">
      <div class="login-logo-name"><%= blogName %></div>
      <div class="login-logo-sub">后台管理系统</div>
    </div>
    <% if (error) { %><div class="alert alert-error">⚠ <%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="form-group">
        <label class="form-label">用户名</label>
        <input type="text" name="username" placeholder="请输入用户名" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label">密码</label>
        <input type="password" name="password" placeholder="请输入密码" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;padding:11px">登 录</button>
    </form>
  </div>
</body></html>
