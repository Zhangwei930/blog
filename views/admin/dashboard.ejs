<%- include('../partials/admin-head') %>
<div class="admin-layout">
<%- include('../partials/admin-sidebar') %>
<main class="admin-main">
  <div class="admin-topbar">
    <div class="admin-topbar-title">仪表盘</div>
    <div class="admin-topbar-right">
      <span class="admin-topbar-user">👤 <%= admin.username %></span>
      <a href="/admin/articles/new" class="btn btn-primary btn-sm">✏️ 写文章</a>
    </div>
  </div>
  <div class="admin-content">

    <!-- 统计卡片 -->
    <div class="stats-grid">
      <div class="stat-card stat-card-green">
        <span class="stat-icon">📄</span>
        <div class="stat-num"><%= stats.articles %></div>
        <div class="stat-label">已发布文章</div>
      </div>
      <div class="stat-card">
        <span class="stat-icon">📋</span>
        <div class="stat-num"><%= stats.drafts %></div>
        <div class="stat-label">草稿箱</div>
      </div>
      <div class="stat-card stat-card-warn">
        <span class="stat-icon">💬</span>
        <div class="stat-num" style="color:#dd6b20"><%= stats.comments %></div>
        <div class="stat-label">待审评论</div>
      </div>
      <div class="stat-card stat-card-blue">
        <span class="stat-icon">👁</span>
        <div class="stat-num" style="color:#3182ce"><%= stats.totalViews %></div>
        <div class="stat-label">总阅读量</div>
      </div>
    </div>

    <!-- 快捷入口 -->
    <div class="quick-actions">
      <a href="/admin/articles/new" class="quick-action">
        <span class="quick-action-icon">✏️</span>
        <span class="quick-action-label">写文章</span>
      </a>
      <a href="/admin/comments?status=pending" class="quick-action">
        <span class="quick-action-icon">💬</span>
        <span class="quick-action-label">审核评论</span>
      </a>
      <a href="/admin/categories" class="quick-action">
        <span class="quick-action-icon">📁</span>
        <span class="quick-action-label">分类管理</span>
      </a>
      <a href="/admin/settings" class="quick-action">
        <span class="quick-action-icon">⚙️</span>
        <span class="quick-action-label">博客设置</span>
      </a>
    </div>

    <div class="dashboard-grid">
      <!-- 最新文章 -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">📄 最新文章</span>
          <a href="/admin/articles" class="btn btn-ghost btn-sm">查看全部 →</a>
        </div>
        <table class="data-table">
          <thead><tr><th>标题</th><th>状态</th><th>时间</th></tr></thead>
          <tbody>
            <% recentArticles.forEach(a => { %>
              <tr>
                <td><a href="/admin/articles/<%= a.id %>/edit" style="color:var(--text);font-weight:500"><%= a.title %></a></td>
                <td><span class="badge badge-<%= a.status %>"><%= a.status==='published'?'已发布':'草稿' %></span></td>
                <td style="color:var(--text-muted);font-size:12.5px"><%= dayjs(a.created_at).format('MM-DD') %></td>
              </tr>
            <% }) %>
            <% if (recentArticles.length===0) { %>
              <tr><td colspan="3" class="empty" style="text-align:center;padding:20px">暂无文章</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- 待审评论 -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">💬 待审评论</span>
          <a href="/admin/comments" class="btn btn-ghost btn-sm">全部 →</a>
        </div>
        <% recentComments.forEach(c => { %>
          <div class="comment-item">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
              <strong style="font-size:13.5px"><%= c.author_name %></strong>
              <span style="font-size:12px;color:var(--text-muted)">评论了《<%= c.article_title.slice(0,12) %>...》</span>
            </div>
            <p><%= c.content.slice(0,60) %><%= c.content.length>60?'...':'' %></p>
            <form method="POST" action="/admin/comments/<%= c.id %>/approve" style="display:inline">
              <button class="btn btn-success btn-sm">✓ 批准</button>
            </form>
          </div>
        <% }) %>
        <% if (recentComments.length===0) { %>
          <div class="empty-state" style="padding:24px">
            <div class="empty-state-icon">✅</div>
            <p>暂无待审评论</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>
</div>
</body></html>
