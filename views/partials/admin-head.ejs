<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> - <%= blogName %> 后台</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
<script>
function toggleNav() {
  const nav = document.querySelector('.admin-nav');
  const btn = document.querySelector('.admin-hamburger');
  nav.classList.toggle('open');
  btn.textContent = nav.classList.contains('open') ? '✕' : '☰';
}
// 点击遮罩关闭
document.addEventListener('click', function(e) {
  if (window.innerWidth > 768) return;
  const nav = document.querySelector('.admin-nav');
  const btn = document.querySelector('.admin-hamburger');
  if (nav && !nav.contains(e.target) && btn && !btn.contains(e.target)) {
    nav.classList.remove('open');
    if (btn) btn.textContent = '☰';
  }
});
// 根据屏幕宽度显示/隐藏汉堡按钮
function checkSize() {
  const btn = document.querySelector('.admin-hamburger');
  if (!btn) return;
  btn.style.display = window.innerWidth <= 768 ? 'flex' : 'none';
}
window.addEventListener('resize', checkSize);
window.addEventListener('load', checkSize);
</script>
</head>
<body class="admin-body">
