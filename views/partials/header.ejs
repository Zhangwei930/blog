<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo">
        <% if (blogAvatar) { %><img src="<%= blogAvatar %>" alt="avatar" class="logo-avatar"><% } %>
        <div class="logo-text">
          <span class="logo-name"><%= blogName %></span>
          <span class="logo-desc"><%= blogDesc %></span>
        </div>
      </a>
      <nav class="main-nav">
        <a href="/">首页</a>
        <a href="/archive">归档</a>
        <% categories.slice(0,4).forEach(cat => { %>
          <a href="/category/<%= cat.slug %>"><%= cat.name %></a>
        <% }) %>
        <a href="/about">关于</a>
      </nav>
      <button class="menu-toggle" onclick="document.querySelector('.main-nav').classList.toggle('open')">☰</button>
    </div>
  </div>
</header>
