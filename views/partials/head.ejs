<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= typeof article !== 'undefined' && article ? article.excerpt : blogDesc %>">
  <meta name="keywords" content="<%= blogDesc %>">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= blogName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
