<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= blogDesc %>">
  <title><%= title ? title+' - ' : '' %><%= blogName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/knowledge.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="kb-body">
<header class="kb-header">
  <div class="kb-header-inner">
    <a href="/" class="kb-logo">
      <% if (blogAvatar) { %><img src="<%= blogAvatar %>" alt="logo" class="kb-logo-img"><% } %>
      <span class="kb-logo-name"><%= blogName %></span>
    </a>
    <nav class="kb-nav">
      <a href="/" class="active">首页</a>
      <a href="/archive">归档</a>
      <% categories.slice(0,5).forEach(cat => { %><a href="/category/<%= cat.slug %>"><%= cat.name %></a><% }) %>
      <a href="/about">关于</a>
    </nav>
    <form class="kb-nav-search" action="/search" method="GET">
      <svg class="kb-nav-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" class="kb-nav-search-input" placeholder="搜索文章…" autocomplete="off">
      <button type="submit" class="kb-nav-search-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
    </form>
    <button class="kb-menu-toggle" onclick="document.querySelector('.kb-nav').classList.toggle('open')">☰</button>
  </div>
</header>

<% if (!category && !searchQuery) { %>
<div class="kb-hero">
  <div class="kb-hero-inner">
    <div class="kb-hero-content">
      <div class="kb-hero-eyebrow">PERSONAL BLOG</div>
      <div class="kb-hero-title-row">
        <h1 class="kb-hero-title"><%= blogName %></h1>
        <div class="kb-hero-stats">
          <div class="kb-stat"><span class="kb-stat-num"><%= totalArticles %></span><span class="kb-stat-label">篇文章</span></div>
          <div class="kb-stat"><span class="kb-stat-num"><%= categories.length %></span><span class="kb-stat-label">个分类</span></div>
          <div class="kb-stat"><span class="kb-stat-num"><%= totalViews %></span><span class="kb-stat-label">次阅读</span></div>
        </div>
      </div>
      <p class="kb-hero-desc"><%= blogDesc %></p>
    </div>
    <div class="kb-hero-deco">
      <div class="kb-deco-sq"></div>
      <div class="kb-deco-sq"></div>
      <div class="kb-deco-sq"></div>
      <div class="kb-deco-sq"></div>
    </div>
  </div>
</div>

<div class="kb-main">
  <% if (categoryGroups && categoryGroups.length > 0) { %>
    <div class="kb-section-hd"><h2>📂 知识分类</h2></div>
    <div class="kb-grid">
      <% categoryGroups.forEach(group => { %>
        <% const totalPages = Math.ceil(Math.max(group.articles.length, 1) / 3); %>
        <div class="kb-card" data-page="0">
          <div class="kb-card-header">
            <span class="kb-card-icon">📄</span>
            <h3 class="kb-card-title"><a href="/category/<%= group.slug %>"><%= group.name %></a></h3>
            <div class="kb-card-header-right">
              <span class="kb-card-count"><%= group.total %> 篇</span>
            </div>
          </div>
          <ul class="kb-article-list">
            <% if (group.articles.length === 0) { %>
              <li class="kb-article-empty">暂无文章，快来创作第一篇</li>
            <% } else { %>
              <% group.articles.forEach((a, idx) => { %>
                <li class="kb-article-item"<%= idx >= 3 ? ' style="display:none"' : '' %>>
                  <a href="/article/<%= a.slug %>" class="kb-article-link"><%= a.title %></a>
                  <span class="kb-article-views"><%= a.views %></span>
                </li>
              <% }) %>
            <% } %>
          </ul>
          <div class="kb-card-footer">
            <button class="kb-pager-btn" onclick="catPage(this,-1)" disabled>← 上一页</button>
            <span class="kb-pager-info">第 1 页 / 共 <%= totalPages %> 页</span>
            <button class="kb-pager-btn" onclick="catPage(this,1)" <%= totalPages <= 1 ? 'disabled' : '' %>>下一页 →</button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (latestArticles && latestArticles.length > 0) { %>
    <div class="kb-section-hd"><h2>🆕 最新发布</h2></div>
    <div class="kb-latest-grid">
      <% latestArticles.forEach(a => { %>
        <a href="/article/<%= a.slug %>" class="kb-latest-card">
          <div class="kb-latest-cover<%= a.cover_image ? ' has-img' : '' %>">
            <% if (a.cover_image) { %>
              <img src="<%= a.cover_image %>" alt="">
            <% } else { %>
              <span style="font-size:36px">📝</span>
            <% } %>
          </div>
          <div class="kb-latest-body">
            <div class="kb-latest-meta">
              <% if (a.category_name) { %><span class="kb-latest-cat"><%= a.category_name %></span><% } %>
              <span class="kb-latest-views">👁 <%= a.views %></span>
            </div>
            <h3 class="kb-latest-title"><%= a.title %></h3>
            <p class="kb-latest-excerpt"><%= a.excerpt || '' %></p>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<% } else if (searchQuery) { %>
<div class="kb-page-wrap">
  <div class="kb-page-hd">
    <h1>🔍 搜索结果</h1>
    <p>「<%= searchQuery %>」</p>
    <span class="kb-page-count"><%= articles.length %> 篇</span>
  </div>
  <div class="kb-list-card">
    <% articles.forEach(a => { %>
      <div class="kb-list-item">
        <div class="kb-list-main">
          <a href="/article/<%= a.slug %>" class="kb-list-link"><%= a.title %></a>
          <% if (a.excerpt) { %><p class="kb-list-excerpt"><%= a.excerpt.slice(0,80) %>…</p><% } %>
        </div>
        <div class="kb-list-right">
          <% if (a.category_name) { %><span class="kb-list-cat"><%= a.category_name %></span><% } %>
          <span class="kb-list-views"><%= a.views %> 阅读</span>
        </div>
      </div>
    <% }) %>
    <% if (articles.length === 0) { %>
      <div style="text-align:center;padding:48px;color:#aaa">未找到与「<%= searchQuery %>」相关的文章</div>
    <% } %>
  </div>
</div>
<% } else { %>
<div class="kb-page-wrap">
  <div class="kb-page-hd">
    <h1>📂 <%= category.name %></h1>
    <% if (category.description) { %><p><%= category.description %></p><% } %>
    <span class="kb-page-count">共 <%= articles.length %> 篇</span>
  </div>
  <div class="kb-list-card">
    <% articles.forEach(a => { %>
      <div class="kb-list-item">
        <a href="/article/<%= a.slug %>" class="kb-list-link"><%= a.title %></a>
        <span class="kb-list-views"><%= a.views %> 阅读</span>
      </div>
    <% }) %>
    <% if (articles.length === 0) { %>
      <div style="text-align:center;padding:32px;color:#aaa">暂无文章</div>
    <% } %>
  </div>
  <% if (totalPages > 1) { %>
    <div class="kb-pagination">
      <% if (page>1) { %><a href="?page=<%= page-1 %>" class="kb-btn">← 上一页</a><% } %>
      <span class="kb-page-info">第 <%= page %> / <%= totalPages %> 页</span>
      <% if (page<totalPages) { %><a href="?page=<%= page+1 %>" class="kb-btn">下一页 →</a><% } %>
    </div>
  <% } %>
</div>
<% } %>

<footer class="kb-footer">
  <p><%= footerText %></p>
  <% if (icpNumber) { %><p><a href="https://beian.miit.gov.cn" target="_blank"><%= icpNumber %></a></p><% } %>
</footer>
<script src="/js/main.js"></script>
<script>
function catPage(btn, dir) {
  const card = btn.closest('.kb-card');
  const items = card.querySelectorAll('.kb-article-item');
  const totalPages = Math.ceil(items.length / 3);
  let page = (parseInt(card.dataset.page) || 0) + dir;
  page = Math.max(0, Math.min(totalPages - 1, page));
  card.dataset.page = page;
  items.forEach(function(el, i) {
    el.style.display = (i >= page * 3 && i < (page + 1) * 3) ? 'flex' : 'none';
  });
  var info = card.querySelector('.kb-pager-info');
  if (info) info.textContent = '第 ' + (page + 1) + ' 页 / 共 ' + totalPages + ' 页';
  var btns = card.querySelectorAll('.kb-pager-btn');
  btns[0].disabled = page === 0;
  btns[1].disabled = page === totalPages - 1;
}
</script>
</body></html>
